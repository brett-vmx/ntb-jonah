---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ChapterCard from '../components/ChapterCard.astro';

const all = await getCollection('chapters');
const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const chapters = all.sort(byOrder);

const chapterData = await Promise.all(
  chapters.map(async (c) => {
    const blocks = await Promise.all(
      c.data.blocks.map(async (b) => {
        if (b.type === 'image') {
          const optimized = await getImage({ src: b.file, width: 800, format: 'webp', quality: 80 });
          return { type: 'image', src: optimized.src };
        }
        return b;
      }),
    );
    return {
      chapterNumber: c.data.chapterNumber,
      labelBo: c.data.labelBo,
      sectionTitleBo: c.data.sectionTitleBo,
      labelEn: c.data.labelEn,
      sectionTitleEn: c.data.sectionTitleEn,
      labelCmn: c.data.labelCmn,
      sectionTitleCmn: c.data.sectionTitleCmn,
      audio: c.data.audio,
      duration: c.data.duration,
      timing: c.data.timing,
      blocks,
    };
  }),
);
---

<Layout>
  <div class="px-4 py-6">
    <div class="grid grid-cols-2 gap-4">
      {
        chapters.map((c) => (
          <ChapterCard chapterNumber={c.data.chapterNumber} labelBo={c.data.labelBo} cover={c.data.cover} />
        ))
      }
    </div>

    <!-- Cross-promo: the full New Tibetan Bible app (separate app, same translation committee) -->
    <section class="mt-10 pt-6 border-t border-ink/10 text-center">
      <p class="text-sm font-bold text-ink/80 mb-1">Get the full New Tibetan Bible app</p>
      <p class="text-xs text-ink/50 mb-4 max-w-[280px] mx-auto">
        The complete Bible in Central, Amdo, and Kham Tibetan — read, listen, and study.
      </p>
      <div class="flex items-center justify-center gap-3">
        <a href="https://apps.apple.com/my/app/new-tibetan-bible/id1515160881" target="_blank" rel="noopener noreferrer" aria-label="Download New Tibetan Bible on the App Store">
          <img src="/badges/app-store-badge.svg" alt="Download on the App Store" style="height:42px" />
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.tibetanapp" target="_blank" rel="noopener noreferrer" aria-label="Get New Tibetan Bible on Google Play">
          <!-- Google's official badge PNG bakes in ~16% transparent margin on
               all sides (unlike Apple's tightly-cropped SVG), so it needs a
               taller display height for its visible logo to match Apple's
               42px — 42 / (168/250) ≈ 62.5px. Still the official artwork
               as-is, just scaled to look the same size next to Apple's. -->
          <img src="/badges/google-play-badge.png" alt="Get it on Google Play" style="height:62.5px" />
        </a>
      </div>
    </section>
  </div>

  <!-- ===================== CHAPTER MODAL ===================== -->
  <div id="chapter-modal" class="fixed inset-0 z-50 hidden">
    <div id="modal-backdrop" class="absolute inset-0 bg-black/60"></div>
    <div
      id="modal-panel"
      class="absolute bottom-0 left-0 right-0 rounded-t-2xl max-h-[calc(100dvh_-_var(--header-h,90px)_-_8px)]
             md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:w-full md:max-w-[448px] md:rounded-2xl md:max-h-[90dvh]
             bg-page flex flex-col transition-transform duration-300 translate-y-full"
    >
      <div class="flex-1 min-h-0 overflow-y-auto">
        <div id="modal-content"></div>
      </div>
      <!-- Sticky LISTEN bar: stays put while modal-content above scrolls (per John's "sticky player" ask) -->
      <div id="modal-listen-bar" class="shrink-0"></div>
      <button id="modal-close" type="button" aria-label="Close chapter"
        style="position:absolute;top:1rem;right:1rem;z-index:10;width:2.25rem;height:2.25rem;display:flex;align-items:center;justify-content:center;border-radius:9999px;background:#CFB63C;border:none;cursor:pointer;color:#000;box-shadow:0 1px 3px rgba(0,0,0,.2)">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</Layout>

<style is:global>
  /* Read-along highlight for the verse currently playing (only lights up */
  /* when the active dialect has verse-timing data — see settings-store.ts). */
  #modal-blocks [data-verse].verse-active {
    background: rgba(207, 182, 60, 0.22);
    border-radius: 8px;
    margin-left: -0.6rem;
    margin-right: -0.6rem;
    padding-left: 0.6rem;
    padding-right: 0.6rem;
    transition: background-color 0.2s ease;
  }

  #modal-prev-btn:disabled, #modal-next-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Verse numbers: deliberately NOT the Tibetan reading font — its digit
     glyphs read oversized/high next to Latin numerals at the same nominal
     size (John: "the numbers are embedded into the Tibetan fonts"). A plain
     system font at a smaller relative size plus vertical-align:middle
     (instead of the default <sup> "super" baseline) is what actually reads
     as "smaller and lower" per his and Brett's feedback. */
  .verse-num {
    font-family: system-ui, sans-serif;
    font-size: 0.7em;
    font-weight: 700;
    color: #a38a1e;
    vertical-align: middle;
  }
</style>

<script define:vars={{ chapterData }}>
  window.__CHAPTERS__ = chapterData;
</script>

<script>
  import { getTextLang, getFont, getTextSize, getTextLayout, getDialect, setDialect, DIALECT_LABELS, getPlaybackSpeed, setPlaybackSpeed } from '../i18n/settings-store';
  import type { TextLang, Dialect } from '../i18n/settings-store';

  interface ImageBlock { type: 'image'; src: string }
  interface VerseBlock { type: 'verse'; number: number; bo: string[]; en: string; cmn: string; paragraphStart: boolean }
  type Block = ImageBlock | VerseBlock;
  type TimingTrack = { verse: number; time: number }[] | null;
  type AudioMap<T> = { adx: T; bod: T; khg: T; eng: T; cmn: T };
  interface ChapterEntry {
    chapterNumber: number;
    labelBo: string;
    sectionTitleBo: string;
    labelEn: string;
    sectionTitleEn: string;
    labelCmn: string;
    sectionTitleCmn: string;
    audio: AudioMap<string>;
    duration: AudioMap<string>;
    timing: AudioMap<TimingTrack>;
    blocks: Block[];
  }

  // Only the current reading language's script, not both. For the two
  // non-dialect audio tracks (eng/cmn) there's only ever an English label to
  // fall back to when reading Chinese — DIALECT_LABELS has no cmn-script
  // column, since translating five audio-option names into three scripts
  // felt like real overreach for something this secondary; English reads
  // fine as a fallback there.
  function dialectDisplay(dialect: Dialect, lang: TextLang): string {
    const { en, bo } = DIALECT_LABELS[dialect];
    return lang === 'bo' ? `<span class="tibetan">${bo}</span>` : en;
  }

  // Reading-language script class, used everywhere a block of text needs
  // its font switched: 'tibetan'/'chinese' pull in the self-hosted webfonts
  // (global.css), English needs no class (default sans stack).
  function scriptClass(lang: TextLang): string {
    if (lang === 'bo') return 'tibetan';
    if (lang === 'cmn') return 'chinese';
    return '';
  }

  const CHEVRON_LEFT = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"/></svg>`;
  const CHEVRON_RIGHT = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>`;

  // Previous/next-CHAPTER nav at the bottom of the reading content — distinct
  // from the prev/next-VERSE transport buttons on the LISTEN bar. Just a
  // number + chevron per John's spec, not "Chapter N", since the chapter
  // label/title already say that at the top.
  function chapterNavHtml(n: number, maxChapter: number): string {
    const prev = n > 1
      ? `<a href="/chapter/${n - 1}" data-goto-chapter="${n - 1}" style="display:flex;align-items:center;gap:.3rem;color:#1c1710;font-weight:700;font-size:1.1rem;text-decoration:none">${CHEVRON_LEFT}<span>${n - 1}</span></a>`
      : '<span></span>';
    const next = n < maxChapter
      ? `<a href="/chapter/${n + 1}" data-goto-chapter="${n + 1}" style="display:flex;align-items:center;gap:.3rem;color:#1c1710;font-weight:700;font-size:1.1rem;text-decoration:none"><span>${n + 1}</span>${CHEVRON_RIGHT}</a>`
      : '<span></span>';
    return `
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:1.75rem;padding:0 .25rem">
        ${prev}
        ${next}
      </div>`;
  }

  const COPYRIGHT_HTML = `
    <p style="margin-top:2rem;padding-top:1.25rem;border-top:1px solid rgba(28,23,16,.1);font-size:.8rem;color:rgba(28,23,16,.55);line-height:1.6">
      Text © 2016–2025 New Tibetan Bible translation committee, used under
      <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" style="color:#a38a1e;text-decoration:underline">CC BY-NC-ND 4.0</a>.
      Illustrations courtesy of Sweet Publishing (public domain).
    </p>`;

  function verseInnerHtml(b: VerseBlock, lang: TextLang): string {
    if (lang === 'bo') {
      return b.bo.length > 1 ? b.bo.map((line) => `<div>${line}</div>`).join('') : b.bo[0];
    }
    return lang === 'cmn' ? b.cmn : b.en;
  }

  // Verse-by-verse: each verse is its own block, full-size leading number.
  function blocksToHtmlVerse(blocks: Block[], lang: TextLang): string {
    return blocks
      .map((b) => {
        if (b.type === 'image') {
          return `<img src="${b.src}" alt="" loading="lazy" style="width:100%;border-radius:10px;margin:1.25rem 0" />`;
        }
        const cls = scriptClass(lang);
        const lineHeight = lang === 'bo' ? 2 : lang === 'cmn' ? 1.9 : 1.75;
        return `
          <div class="verse-block${cls ? ' ' + cls : ''}" data-verse="${b.number}" style="margin-bottom:1rem;font-size:var(--reading-font-size,1.15rem);line-height:${lineHeight}">
            <span class="verse-num" style="margin-right:.25rem">${b.number}</span>${verseInnerHtml(b, lang)}
          </div>`;
      })
      .join('');
  }

  // Paragraph: verses flow together as inline spans (small superscript verse
  // numbers), grouped by the SFM's own \p/\m paragraph breaks. Images still
  // break out of the flow as their own block between paragraphs. Chapter 2's
  // poetic \q1 line breaks are folded into flowing text here (joined with a
  // space, not <br>) — same as the English, which never carried per-line
  // breaks to begin with. Verse-by-verse mode still shows each poetic line
  // on its own line (see verseInnerHtml); that distinction is only a
  // paragraph-flow concern. Chinese has no poetry line breaks in its source
  // either, so it takes the same plain-string path as English.
  function blocksToHtmlParagraph(blocks: Block[], lang: TextLang): string {
    const cls = scriptClass(lang);
    const lineHeight = lang === 'bo' ? 2 : lang === 'cmn' ? 1.9 : 1.75;
    let html = '';
    let para = '';

    const flush = () => {
      if (!para) return;
      html += `<p class="verse-block${cls ? ' ' + cls : ''}" style="margin-bottom:1rem;font-size:var(--reading-font-size,1.15rem);line-height:${lineHeight}">${para}</p>`;
      para = '';
    };

    for (const b of blocks) {
      if (b.type === 'image') {
        flush();
        html += `<img src="${b.src}" alt="" loading="lazy" style="width:100%;border-radius:10px;margin:1.25rem 0" />`;
        continue;
      }
      if (b.paragraphStart) flush();
      const text = lang === 'bo' ? b.bo.join(' ') : lang === 'cmn' ? b.cmn : b.en;
      para += `<span data-verse="${b.number}"><span class="verse-num">${b.number}</span> ${text}</span> `;
    }
    flush();
    return html;
  }

  function blocksToHtml(blocks: Block[], lang: TextLang, layout: 'verse' | 'paragraph'): string {
    return layout === 'paragraph' ? blocksToHtmlParagraph(blocks, lang) : blocksToHtmlVerse(blocks, lang);
  }

  // Transport-control seek behavior, matching Global Bible Tools' AudioPlayer:
  // "previous" restarts the current verse if you're more than PREV_THRESHOLD
  // seconds into it, otherwise jumps back a verse — standard music-player feel.
  const PREV_THRESHOLD = 1.5;

  function findVerseIndex(timings: { verse: number; time: number }[], t: number): number {
    let idx = -1;
    for (let i = 0; i < timings.length; i++) {
      if (timings[i].time <= t) idx = i;
      else break;
    }
    return idx;
  }

  function initModal() {
    const modal      = document.getElementById('chapter-modal');
    const backdrop   = document.getElementById('modal-backdrop');
    const panel      = document.getElementById('modal-panel');
    const closeBtn   = document.getElementById('modal-close');
    const content    = document.getElementById('modal-content');
    const listenBar  = document.getElementById('modal-listen-bar');
    const scrollDiv  = panel?.querySelector<HTMLElement>('.overflow-y-auto') ?? null;
    if (!modal || !backdrop || !panel || !closeBtn || !content || !listenBar) return;

    const chapters: ChapterEntry[] = (window as unknown as { __CHAPTERS__: ChapterEntry[] }).__CHAPTERS__ ?? [];
    let modalOpen   = false;
    let pushedState = false;
    let openChapterEntry: ChapterEntry | null = null;

    const prevAbort = (window as any).__modalAbort as AbortController | undefined;
    if (prevAbort) prevAbort.abort();
    const abort = new AbortController();
    (window as any).__modalAbort = abort;
    const { signal } = abort;

    function renderReadSection() {
      if (!openChapterEntry) return;
      const lang = getTextLang();
      const layout = getTextLayout();
      const blocksEl = document.getElementById('modal-blocks');
      if (blocksEl) blocksEl.innerHTML = blocksToHtml(openChapterEntry.blocks, lang, layout);

      const labelEl = document.getElementById('modal-label');
      const titleEl = document.getElementById('modal-title');
      const label = lang === 'bo' ? openChapterEntry.labelBo : lang === 'cmn' ? openChapterEntry.labelCmn : openChapterEntry.labelEn;
      const sectionTitle = lang === 'bo' ? openChapterEntry.sectionTitleBo : lang === 'cmn' ? openChapterEntry.sectionTitleCmn : openChapterEntry.sectionTitleEn;
      if (labelEl) {
        labelEl.textContent = label;
        labelEl.classList.toggle('tibetan', lang === 'bo');
        labelEl.classList.toggle('chinese', lang === 'cmn');
        // Centered + matching the section title's size, Tibetan only (John:
        // the "Chapter N" line reads better centered and larger in Tibetan;
        // English/Chinese keep the original small left-aligned label).
        labelEl.style.textAlign = lang === 'bo' ? 'center' : 'left';
        labelEl.style.fontSize = lang === 'bo' ? '1.5rem' : '1rem';
      }
      if (titleEl) {
        titleEl.textContent = sectionTitle;
        titleEl.classList.toggle('tibetan', lang === 'bo');
        titleEl.classList.toggle('chinese', lang === 'cmn');
      }

      // Dialect label shows only the current reading language's script, so
      // it needs to update on a language change too, not just a dialect one.
      const dialectLabelEl = document.getElementById('modal-dialect-label');
      if (dialectLabelEl) dialectLabelEl.innerHTML = dialectDisplay(getDialect(), lang);
      populateDialectPopover(lang);

      applyVerseHighlight(); // re-render wiped #modal-blocks, so the highlight needs reapplying
    }

    // Read-along highlight: lights up the verse span/block matching the
    // audio's current playback position, using the active dialect's
    // verse-start timestamps (null for dialects without timing data yet —
    // see settings-store.ts / gen-chapters.mjs). Called on every audio
    // 'timeupdate' tick, plus whenever the READ section re-renders or the
    // dialect (and therefore the timing track) changes, so the highlight
    // never lags behind a settings change. Works the same in both verse and
    // paragraph layout since both wrap each verse in a [data-verse] element.
    function applyVerseHighlight() {
      const blocksEl = document.getElementById('modal-blocks');
      const audio = document.getElementById('modal-audio') as HTMLAudioElement | null;
      if (!blocksEl || !openChapterEntry) return;

      const prevActive = blocksEl.querySelector('[data-verse].verse-active');
      const timings = openChapterEntry.timing[getDialect()];
      if (!timings || !audio) {
        prevActive?.classList.remove('verse-active');
        return;
      }

      const idx = findVerseIndex(timings, audio.currentTime);
      const activeVerse = idx >= 0 ? timings[idx].verse : null;

      if (prevActive && Number(prevActive.getAttribute('data-verse')) === activeVerse) return;
      prevActive?.classList.remove('verse-active');
      if (activeVerse === null) return;

      const el = blocksEl.querySelector(`[data-verse="${activeVerse}"]`);
      if (el) {
        el.classList.add('verse-active');
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function updatePrevNextEnabled() {
      const prevBtn = document.getElementById('modal-prev-btn') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('modal-next-btn') as HTMLButtonElement | null;
      const hasTiming = !!openChapterEntry?.timing[getDialect()];
      if (prevBtn) prevBtn.disabled = !hasTiming;
      if (nextBtn) nextBtn.disabled = !hasTiming;
    }

    function updateAudioForDialect() {
      if (!openChapterEntry) return;
      const audio = document.getElementById('modal-audio') as HTMLAudioElement | null;
      const timeDisplay = document.getElementById('modal-time-display') as HTMLElement | null;
      const dialectLabel = document.getElementById('modal-dialect-label');
      if (!audio || !timeDisplay) return;

      const dialect = getDialect();
      const rate = audio.playbackRate; // preserved across load() by spec, but pin it explicitly
      audio.pause();
      audio.src = openChapterEntry.audio[dialect];
      audio.load();
      audio.playbackRate = rate;
      timeDisplay.textContent = `0:00 / ${openChapterEntry.duration[dialect]}`;
      if (dialectLabel) dialectLabel.innerHTML = dialectDisplay(dialect, getTextLang());

      const fill = document.getElementById('modal-progress-fill') as HTMLElement | null;
      const playBtn = document.getElementById('modal-play-btn') as HTMLElement | null;
      if (fill) fill.style.width = '0%';
      if (playBtn) playBtn.style.left = '0%';
      const playIcon = document.getElementById('modal-play-icon') as SVGElement | null;
      const pauseIcon = document.getElementById('modal-pause-icon') as SVGElement | null;
      if (playIcon) playIcon.style.display = '';
      if (pauseIcon) pauseIcon.style.display = 'none';

      updatePrevNextEnabled();
      applyVerseHighlight(); // dialect change swaps the timing track too
      populateDialectPopover(getTextLang());
    }

    // Fills in the LISTEN bar's dialect popover options (labels + which one
    // reads as active) — called after every (re)render of the popover's DOM
    // (chapter open) and whenever language or dialect changes, since neither
    // regenerates the popover markup itself.
    function populateDialectPopover(lang: TextLang) {
      const popover = document.getElementById('modal-dialect-popover');
      if (!popover) return;
      const current = getDialect();
      popover.querySelectorAll<HTMLButtonElement>('.modal-dialect-option').forEach((btn) => {
        const d = btn.dataset.pickDialect as Dialect;
        btn.innerHTML = dialectDisplay(d, lang);
        const active = d === current;
        btn.style.background = active ? 'rgba(207,182,60,.25)' : 'none';
        btn.style.fontWeight = active ? '800' : '600';
      });
    }

    // Toggle + outside-click-to-close for the dialect popover, bound once
    // here (not per chapter-open) — it looks up the current button/popover
    // nodes by id on every click rather than closing over references, since
    // those nodes are recreated on every openChapter() call.
    document.addEventListener('click', (e) => {
      const popover = document.getElementById('modal-dialect-popover');
      const btn = document.getElementById('modal-dialect-btn');
      if (!popover || !btn || popover.classList.contains('hidden')) return;
      const target = e.target as Node;
      if (btn.contains(target) || popover.contains(target)) return;
      popover.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }, { signal });

    window.addEventListener('jonah:text-settings-changed', renderReadSection, { signal });
    window.addEventListener('jonah:dialect-changed', updateAudioForDialect, { signal });

    function openChapter(n: number) {
      const chapter = chapters.find((c) => c.chapterNumber === n);
      if (!chapter) return;

      // Navigating chapter-to-chapter via the new bottom nav calls this
      // again while a chapter is already open — stop the outgoing chapter's
      // audio explicitly rather than relying on element-removal side effects.
      const outgoingAudio = document.getElementById('modal-audio') as HTMLAudioElement | null;
      outgoingAudio?.pause();

      openChapterEntry = chapter;
      const dialect = getDialect();
      const lang = getTextLang();
      const layout = getTextLayout();
      const label = lang === 'bo' ? chapter.labelBo : lang === 'cmn' ? chapter.labelCmn : chapter.labelEn;
      const sectionTitle = lang === 'bo' ? chapter.sectionTitleBo : lang === 'cmn' ? chapter.sectionTitleCmn : chapter.sectionTitleEn;
      const scriptCls = scriptClass(lang);

      content.innerHTML = `
        <div class="pt-6 md:pt-11" style="padding-left:1.25rem;padding-right:1.25rem;padding-bottom:1rem">
          <p id="modal-label" class="${scriptCls}" style="color:#a38a1e;font-weight:700;font-size:${lang === 'bo' ? '1.5rem' : '1rem'};text-align:${lang === 'bo' ? 'center' : 'left'};margin-bottom:.25rem;padding-right:2.5rem">${label}</p>
          <h2 id="modal-title" class="${scriptCls}" style="font-size:1.5rem;font-weight:700;color:#1c1710;margin-bottom:1.5rem;line-height:1.5;padding-right:2.5rem">${sectionTitle}</h2>

          <!-- READ -->
          <section>
            <div style="background:#fff;border-radius:10px;padding:1.25rem;box-shadow:0 1px 3px rgba(0,0,0,.1)">
              <div id="modal-blocks">
                ${blocksToHtml(chapter.blocks, lang, layout)}
              </div>
            </div>
          </section>

          ${chapterNavHtml(n, chapters.length)}

          ${COPYRIGHT_HTML}
        </div>
      `;

      listenBar.innerHTML = `
        <div style="position:relative;margin:0 1.25rem 1rem;background:#cfb63c;border-radius:14px 0 14px 14px;padding:1.1rem;box-shadow:0 2px 8px rgba(0,0,0,.2)">
          <!-- Dialect picker as a "notch" tab, gold (same as the tile, so
               it reads as one continuous shape, not a separate floating
               chip) and right-aligned, replacing the old full-width row 1
               (LISTEN label + dialect, removed per Brett's request — see
               "Sticky LISTEN bar" in CLAUDE.md). bottom:100% sits it
               flush on top of the tile's own top edge — no extra margin
               reserved above the tile itself, so reading content still
               flows/scrolls all the way up to the tile everywhere except
               directly behind the notch's own small footprint. The tile's
               own top-right corner is deliberately square (border-radius
               "14px 0 14px 14px", not a flat 14px) so its right edge runs
               straight up to meet the notch with no curve of its own —
               the notch's right side (flush at right:0, square bottom
               corner) continues that same straight line, and only curves
               again at the very top (the notch's own rounded top-right
               corner). One smooth right edge for the whole composite
               shape, not two competing curves close together where the
               notch meets the tile. -->
          <div style="position:absolute;right:0;bottom:100%;z-index:5">
            <button id="modal-dialect-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Switch dialect"
              style="display:flex;align-items:center;gap:.3rem;white-space:nowrap;background:#cfb63c;border:none;border-radius:14px 14px 0 0;padding:.5rem 1.1rem;font-size:.8rem;font-weight:700;color:#1c1710;cursor:pointer">
              <span id="modal-dialect-label">${dialectDisplay(dialect, lang)}</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <!-- Opens upward (bottom:100%, not top:100%) — the notch sits
                 near the top of the LISTEN bar, which is itself near the
                 bottom of the modal, so opening downward would land on top
                 of the tile's own seek track/controls below it. Right-
                 aligned under the notch, matching the notch's own
                 alignment. -->
            <div id="modal-dialect-popover" class="hidden" style="position:absolute;bottom:100%;right:0;margin-bottom:.5rem;background:#fff;border-radius:.75rem;box-shadow:0 4px 16px rgba(0,0,0,.25);overflow:hidden;z-index:20;min-width:110px">
              <button type="button" data-pick-dialect="adx" class="modal-dialect-option" style="display:block;width:100%;text-align:left;padding:.6rem 1rem;background:none;border:none;font-size:.9rem;color:#1c1710;cursor:pointer"></button>
              <button type="button" data-pick-dialect="bod" class="modal-dialect-option" style="display:block;width:100%;text-align:left;padding:.6rem 1rem;background:none;border:none;font-size:.9rem;color:#1c1710;cursor:pointer"></button>
              <button type="button" data-pick-dialect="khg" class="modal-dialect-option" style="display:block;width:100%;text-align:left;padding:.6rem 1rem;background:none;border:none;font-size:.9rem;color:#1c1710;cursor:pointer"></button>
              <button type="button" data-pick-dialect="eng" class="modal-dialect-option" style="display:block;width:100%;text-align:left;padding:.6rem 1rem;background:none;border:none;font-size:.9rem;color:#1c1710;cursor:pointer"></button>
              <button type="button" data-pick-dialect="cmn" class="modal-dialect-option" style="display:block;width:100%;text-align:left;padding:.6rem 1rem;background:none;border:none;font-size:.9rem;color:#1c1710;cursor:pointer"></button>
            </div>
          </div>
          <audio id="modal-audio" preload="metadata" crossorigin="anonymous" src="${chapter.audio[dialect]}" style="display:none"></audio>

          <!-- Row 1 (was row 2): audio position, combined with play/pause —
               the circle that marks where playback is also toggles
               play/pause. The track is inset horizontally by half the
               button's width (17px) so the button's own edges — not its
               center — land flush with the tile's left content edge and
               the dialect/speed controls' right edge at the 0%/100%
               extremes. -->
          <div style="padding:19px 17px">
            <div id="modal-progress-track" style="position:relative;width:100%;height:6px;border-radius:9999px;background:rgba(28,23,16,.25);cursor:pointer;touch-action:none">
              <div id="modal-progress-fill" style="position:absolute;top:0;left:0;height:100%;border-radius:9999px;background:#1c1710;width:0%;pointer-events:none"></div>
              <button id="modal-play-btn" type="button" aria-label="Play"
                style="position:absolute;top:50%;left:0%;transform:translate(-50%,-50%);width:34px;height:34px;border-radius:9999px;background:#1c1710;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.3)">
                <svg id="modal-play-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="white" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <svg id="modal-pause-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="white" aria-hidden="true" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
              </button>
            </div>
          </div>

          <!-- Row 2 (was row 3): time indicator — prev/next chevrons — loop + speed.
               The loop+speed pair is grouped as one flex child (fixed-ish
               width: a constant-size icon button plus the speed button's
               own fixed width) so it still acts as a single third item
               under justify-content:space-between — the chevrons' centered
               position never shifts as either the loop icon or the speed
               label changes, same reasoning as the speed button's own
               fixed width before this. -->
          <div style="display:flex;align-items:center;justify-content:space-between">
            <span id="modal-time-display" style="font-size:.85rem;color:#1c1710;font-weight:600">0:00 / ${chapter.duration[dialect]}</span>
            <div style="display:flex;align-items:center;gap:1.5rem">
              <button id="modal-prev-btn" type="button" aria-label="Previous verse" style="background:none;border:none;padding:0;cursor:pointer;color:#1c1710;display:flex;align-items:center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"/></svg>
              </button>
              <button id="modal-next-btn" type="button" aria-label="Next verse" style="background:none;border:none;padding:0;cursor:pointer;color:#1c1710;display:flex;align-items:center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
              </button>
            </div>
            <div style="display:flex;align-items:center;gap:.85rem">
              <button id="modal-loop-btn" type="button" aria-label="Loop: off" style="background:none;border:none;padding:0;cursor:pointer;color:#1c1710;display:flex;align-items:center;opacity:.35">
                <svg id="modal-loop-icon-all" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>
                </svg>
                <svg id="modal-loop-icon-one" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
                  <path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/><path d="M11 10h1v4"/>
                </svg>
              </button>
              <button id="modal-speed-btn" type="button" aria-label="Playback speed"
                style="background:none;border:none;padding:0;width:2.75rem;text-align:right;font-size:.8rem;font-weight:700;color:#1c1710;cursor:pointer">1×</button>
            </div>
          </div>
        </div>
      `;

      initAudioPlayer(chapter.duration[dialect]);
      initDialectPopover();
      updatePrevNextEnabled();

      // Chapter-to-chapter nav at the bottom of the reading content is
      // regenerated on every openChapter() call, so its links need fresh
      // listeners each time too (same reasoning as initAudioPlayer above).
      content.querySelectorAll<HTMLAnchorElement>('a[data-goto-chapter]').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          openChapter(Number(link.dataset.gotoChapter));
        });
      });

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (scrollDiv) scrollDiv.scrollTop = 0;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          panel.classList.remove('translate-y-full');
          panel.classList.add('translate-y-0');
        });
      });
      modalOpen = true;

      if (window.location.pathname !== `/chapter/${n}`) {
        history.pushState({ modal: n }, '', `/chapter/${n}`);
        pushedState = true;
      }
    }

    // Re-bound on every openChapter() call since the popover's DOM is
    // recreated with the rest of the LISTEN bar — same reasoning as
    // initAudioPlayer below. The outside-click-to-close listener is NOT
    // here; that one's bound once, outside this function (see above).
    function initDialectPopover() {
      const btn = document.getElementById('modal-dialect-btn') as HTMLButtonElement | null;
      const popover = document.getElementById('modal-dialect-popover');
      if (!btn || !popover) return;

      populateDialectPopover(getTextLang()); // fresh DOM each chapter open — needs its initial fill

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const wasHidden = popover.classList.contains('hidden');
        popover.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(wasHidden));
      });
      popover.querySelectorAll<HTMLButtonElement>('.modal-dialect-option').forEach((optBtn) => {
        optBtn.addEventListener('click', () => {
          setDialect(optBtn.dataset.pickDialect as Dialect);
          popover.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    }

    const SPEEDS = [0.5, 0.7, 0.8, 0.9, 1, 1.1, 1.2, 1.3, 1.5];

    function initAudioPlayer(initialDuration: string) {
      const audio      = document.getElementById('modal-audio')       as HTMLAudioElement | null;
      const track      = document.getElementById('modal-progress-track') as HTMLElement | null;
      const fill       = document.getElementById('modal-progress-fill') as HTMLElement | null;
      const playBtn    = document.getElementById('modal-play-btn')    as HTMLButtonElement | null;
      const playIcon   = document.getElementById('modal-play-icon')   as SVGElement | null;
      const pauseIcon  = document.getElementById('modal-pause-icon')  as SVGElement | null;
      const prevBtn    = document.getElementById('modal-prev-btn')    as HTMLButtonElement | null;
      const nextBtn    = document.getElementById('modal-next-btn')    as HTMLButtonElement | null;
      const timeDisplay = document.getElementById('modal-time-display') as HTMLElement | null;
      const speedBtn   = document.getElementById('modal-speed-btn')   as HTMLButtonElement | null;
      const loopBtn    = document.getElementById('modal-loop-btn')    as HTMLButtonElement | null;
      const loopIconAll = document.getElementById('modal-loop-icon-all') as SVGElement | null;
      const loopIconOne = document.getElementById('modal-loop-icon-one') as SVGElement | null;
      if (!audio || !track || !fill || !playBtn || !playIcon || !pauseIcon || !prevBtn || !nextBtn || !timeDisplay || !speedBtn || !loopBtn || !loopIconAll || !loopIconOne) return;

      let totalLabel = initialDuration;
      // Persisted across chapters within a session (John: it used to reset
      // to 1x on every chapter switch) — settings-store.ts holds the value,
      // this just applies it to the fresh <audio> element each chapter open
      // creates.
      let speedIndex = SPEEDS.indexOf(getPlaybackSpeed());
      if (speedIndex < 0) speedIndex = SPEEDS.indexOf(1);
      let dragging = false;

      audio.playbackRate = SPEEDS[speedIndex];
      speedBtn.textContent = `${SPEEDS[speedIndex]}×`;

      speedBtn.addEventListener('click', () => {
        speedIndex = (speedIndex + 1) % SPEEDS.length;
        audio.playbackRate = SPEEDS[speedIndex];
        speedBtn.textContent = `${SPEEDS[speedIndex]}×`;
        setPlaybackSpeed(SPEEDS[speedIndex]);
      });

      // Loop control (John's request #10, modeled on Global Bible Tools):
      // off → repeat verse → repeat chapter → off. Not persisted across
      // chapters/sessions like playback speed — it resets to "off" on every
      // chapter open, since looping is a momentary listening choice, not a
      // lasting preference. "Repeat verse" only makes sense with timing
      // data; without it there's no per-verse boundary to loop against, so
      // it's disabled the same way prev/next are (updatePrevNextEnabled).
      type LoopMode = 'off' | 'verse' | 'chapter';
      let loopMode: LoopMode = 'off';
      let loopVerseIdx: number | null = null; // which verse index we're locked to, when loopMode === 'verse'

      function setLoopMode(mode: LoopMode) {
        loopMode = mode;
        loopBtn!.setAttribute('aria-label', `Loop: ${mode}`);
        loopBtn!.style.opacity = mode === 'off' ? '.35' : '1';
        loopIconOne!.style.display = mode === 'verse' ? '' : 'none';
        loopIconAll!.style.display = mode === 'verse' ? 'none' : '';
        if (mode === 'verse') {
          const timings = openChapterEntry?.timing[getDialect()];
          loopVerseIdx = timings ? findVerseIndex(timings, audio.currentTime) : null;
        } else {
          loopVerseIdx = null;
        }
      }

      loopBtn.addEventListener('click', () => {
        setLoopMode(loopMode === 'off' ? 'verse' : loopMode === 'verse' ? 'chapter' : 'off');
      });

      function fmt(secs: number): string {
        const m = Math.floor(secs / 60);
        const s = Math.floor(secs % 60);
        return `${m}:${s.toString().padStart(2, '0')}`;
      }

      function setPlaying(playing: boolean) {
        playIcon!.style.display  = playing ? 'none' : '';
        pauseIcon!.style.display = playing ? '' : 'none';
        playBtn!.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      }

      // The circle marking playback position doubles as the play/pause
      // button (per John's request) — it sits on top of the seek track, so
      // its own click is stopped from also triggering the track's seek
      // handler below.
      function setProgressPct(pct: number) {
        const clamped = Math.max(0, Math.min(100, pct));
        fill!.style.width = clamped + '%';
        playBtn!.style.left = clamped + '%';
      }

      function seekFromClientX(clientX: number) {
        const rect = track!.getBoundingClientRect();
        const pct = ((clientX - rect.left) / rect.width) * 100;
        const clamped = Math.max(0, Math.min(100, pct));
        if (audio.duration) audio.currentTime = (clamped / 100) * audio.duration;
        setProgressPct(clamped);
      }

      function togglePlay() {
        if (audio.paused) { audio.play(); setPlaying(true); }
        else              { audio.pause(); setPlaying(false); }
      }

      // The circle is both the play/pause tap target AND a drag-to-seek
      // thumb (it looks exactly like one, so it needs to behave like one —
      // per feedback, people were trying to grab it and drag it, which did
      // nothing when it only had a plain click handler). A pointerdown on
      // the circle starts a drag; if the pointer never moves more than a
      // few px before release, treat it as a tap (toggle play/pause)
      // instead. Pointer capture keeps the drag tracking correctly even
      // once the finger moves off the small circle and onto the rest of
      // the track.
      const DRAG_MOVE_THRESHOLD = 6;
      let buttonDragging = false;
      let buttonDragMoved = false;
      let buttonDragStartX = 0;

      playBtn.addEventListener('pointerdown', (e) => {
        e.stopPropagation();
        buttonDragging = true;
        buttonDragMoved = false;
        buttonDragStartX = e.clientX;
        playBtn!.setPointerCapture(e.pointerId);
      });
      playBtn.addEventListener('pointermove', (e) => {
        if (!buttonDragging) return;
        if (!buttonDragMoved && Math.abs(e.clientX - buttonDragStartX) > DRAG_MOVE_THRESHOLD) {
          buttonDragMoved = true;
        }
        if (buttonDragMoved) seekFromClientX(e.clientX);
      });
      playBtn.addEventListener('pointerup', (e) => {
        if (!buttonDragging) return;
        buttonDragging = false;
        if (buttonDragMoved) applyVerseHighlight();
        else togglePlay();
      });
      playBtn.addEventListener('pointercancel', () => { buttonDragging = false; });

      track.addEventListener('pointerdown', (e) => {
        if (playBtn!.contains(e.target as Node)) return;
        dragging = true;
        track!.setPointerCapture(e.pointerId);
        seekFromClientX(e.clientX);
      });
      track.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        seekFromClientX(e.clientX);
      });
      track.addEventListener('pointerup', () => {
        if (!dragging) return;
        dragging = false;
        applyVerseHighlight();
      });
      track.addEventListener('pointercancel', () => { dragging = false; });

      prevBtn.addEventListener('click', () => {
        const timings = openChapterEntry?.timing[getDialect()];
        if (!timings) return;
        const idx = findVerseIndex(timings, audio.currentTime);
        if (idx < 0) { audio.currentTime = 0; return; }
        const intoVerse = audio.currentTime - timings[idx].time;
        const targetIdx = (intoVerse > PREV_THRESHOLD || idx === 0) ? idx : idx - 1;
        audio.currentTime = timings[targetIdx].time;
        if (loopMode === 'verse') loopVerseIdx = targetIdx; // re-lock to the verse we jumped to
        applyVerseHighlight();
      });
      nextBtn.addEventListener('click', () => {
        const timings = openChapterEntry?.timing[getDialect()];
        if (!timings) return;
        const idx = findVerseIndex(timings, audio.currentTime);
        const nextIdx = Math.min(idx + 1, timings.length - 1);
        audio.currentTime = timings[nextIdx].time;
        if (loopMode === 'verse') loopVerseIdx = nextIdx; // re-lock to the verse we jumped to
        applyVerseHighlight();
      });

      audio.addEventListener('timeupdate', () => {
        if (!audio.duration || dragging) return;
        const pct = (audio.currentTime / audio.duration) * 100;
        setProgressPct(pct);
        timeDisplay.textContent = `${fmt(audio.currentTime)} / ${totalLabel}`;
        applyVerseHighlight();

        // "Repeat verse": once playback has moved past the locked verse's
        // end (i.e. into the next verse's start), jump back to its start
        // instead of letting it continue — checked every tick, same as the
        // highlight above.
        if (loopMode === 'verse' && loopVerseIdx !== null) {
          const timings = openChapterEntry?.timing[getDialect()];
          if (timings) {
            const idx = findVerseIndex(timings, audio.currentTime);
            if (idx > loopVerseIdx) audio.currentTime = timings[loopVerseIdx].time;
          }
        }
      });

      audio.addEventListener('loadedmetadata', () => {
        totalLabel = fmt(audio.duration);
        timeDisplay.textContent = `${fmt(audio.currentTime)} / ${totalLabel}`;
      });

      audio.addEventListener('ended', () => {
        // "Repeat chapter": restart instead of stopping. "Repeat verse"
        // doesn't need handling here — the timeupdate check above already
        // loops well before the chapter's own end is reached.
        if (loopMode === 'chapter') {
          audio.currentTime = 0;
          audio.play();
          return;
        }
        setPlaying(false);
        setProgressPct(0);
        timeDisplay.textContent = `0:00 / ${totalLabel}`;
      });
    }

    function closeModal(fromPopstate = false) {
      if (!modalOpen) return;
      modalOpen = false;
      openChapterEntry = null;

      const audio = document.getElementById('modal-audio') as HTMLAudioElement | null;
      if (audio) { audio.pause(); audio.src = ''; audio.load(); }

      panel!.classList.remove('translate-y-0');
      panel!.classList.add('translate-y-full');

      let closed = false;
      const finish = () => {
        if (closed) return;
        closed = true;
        modal!.classList.add('hidden');
        document.body.style.overflow = '';
        content!.innerHTML = '';
        listenBar!.innerHTML = '';
      };
      panel!.addEventListener('transitionend', finish, { once: true });
      setTimeout(finish, 350);

      if (!fromPopstate && pushedState) history.back();
      pushedState = false;
    }

    document.querySelectorAll<HTMLAnchorElement>('a[data-chapter]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        openChapter(Number(link.dataset.chapter));
      });
    });

    closeBtn.addEventListener('click', () => closeModal(false));
    backdrop.addEventListener('click', () => closeModal(false));

    let touchStartY = 0;
    panel.addEventListener('touchstart', (e) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });
    panel.addEventListener('touchend', (e) => {
      if (window.innerWidth >= 768) return;
      const deltaY = e.changedTouches[0].clientY - touchStartY;
      if (deltaY > 80 && (scrollDiv?.scrollTop ?? 0) === 0) {
        closeModal(false);
      }
    }, { passive: true });

    // Swipe left/right on the reading content to go to the next/previous
    // chapter (John's request #3 — an alternative to scrolling all the way
    // down to the bottom chapter-nav links). Bound to scrollDiv specifically
    // (the vertically-scrolling wrapper around #modal-content), NOT the
    // whole panel — the LISTEN bar's seek track/play-button drag gesture is
    // a sibling outside scrollDiv, so a deliberate horizontal drag there can
    // never be misread as a chapter-swipe.
    let contentTouchStartX = 0;
    let contentTouchStartY = 0;
    scrollDiv?.addEventListener('touchstart', (e) => {
      contentTouchStartX = e.touches[0].clientX;
      contentTouchStartY = e.touches[0].clientY;
    }, { passive: true, signal });
    scrollDiv?.addEventListener('touchend', (e) => {
      if (!openChapterEntry) return;
      const deltaX = e.changedTouches[0].clientX - contentTouchStartX;
      const deltaY = e.changedTouches[0].clientY - contentTouchStartY;
      if (Math.abs(deltaX) < 70 || Math.abs(deltaY) > 50) return; // require a mostly-horizontal swipe
      const n = openChapterEntry.chapterNumber;
      if (deltaX < 0 && n < chapters.length) openChapter(n + 1);
      else if (deltaX > 0 && n > 1) openChapter(n - 1);
    }, { passive: true, signal });

    // Handles both directions of browser back/forward: closes the modal
    // when the URL lands back on '/', opens (or switches to) the right
    // chapter's modal when it lands on '/chapter/N' — covers forward
    // navigation into a chapter, not just backward out of one. Listens for
    // our own 'jonah:popstate' custom event (dispatched by the early
    // interceptor script in Layout.astro), not the native 'popstate'
    // directly — see that script's comment for why: Astro's ClientRouter
    // treats a native popstate as a real page-transition target and
    // fetches the static /chapter/[n].astro fallback instead, a known
    // unresolved Astro bug (withastro/astro#13943). Also runs once
    // unconditionally on load to open the right chapter for a direct
    // /chapter/N link, same as before.
    function syncModalToUrl() {
      const m = window.location.pathname.match(/^\/chapter\/(\d+)$/);
      if (m) {
        const n = Number(m[1]);
        if (openChapterEntry?.chapterNumber === n) return; // already showing it
        if (chapters.find((c) => c.chapterNumber === n)) {
          pushedState = false; // URL already reflects this state — openChapter() won't push again
          openChapter(n);
        }
      } else if (modalOpen) {
        closeModal(true);
      }
    }

    window.addEventListener('jonah:popstate', syncModalToUrl, { signal });
    syncModalToUrl();
  }

  document.addEventListener('astro:page-load', () => {
    initModal();
  });
</script>
