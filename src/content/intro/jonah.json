{
  "mainTitle": "༄༅། །ལུང་སྟོན་པ་ཡོ་ནཱའི་མདོ།",
  "introTitle": "ལུང་སྟོན་པ་ཡོ་ནཱའི་མདོ་ཞེས་བྱ་བའི་ངོ་སྤྲོད་མདོར་བསྡུས།",
  "sections": [
    {
      "heading": "ཁ་བྱང་དང་ལོ་རྒྱུས་རྒྱབ་ལྗོངས།",
      "paragraphs": [
        "གཞུང་འདིའི་ཁ་བྱང་ནི་མི་སྣ་གཙོ་བོ་ཡོ་ནཱ་ཞེས་བྱ་བའི་མིང་ནས་ཐོགས་པ་ཡིན། མིང་དེ་ཕུག་རོན་ཞེས་པའི་དོན་ལ་འཇུག གཞུང་གི་ནང་དུ་བརྗོད་པའི་དོན་དག་རྣམས་ཧ་ལམ་སྤྱི་ལོ་སྔོན་གྱི་དུས་རབས་བརྒྱད་པའི་སྐབས་སུ་བྱུང་བ་ཡིན། སྐབས་དེར་ཡ་ཧུ་དཱ་མི་རིགས་ནི་ཨ་སུར་པ་རྣམས་ལ་ཞེད་ཅིང་འཇིགས་པ་དང་། ཨ་སུར་པ་རྣམས་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་དགྲ་ངན་ཡིན།"
      ]
    },
    {
      "heading": "ཡི་གེར་འགོད་མཁན་དང་འགོད་དུས།",
      "paragraphs": [
        "སྲོལ་རྒྱུན་ལྟར་ན་གཞུང་འདི་ཉིད་ཡི་གེར་འགོད་མཁན་ནི་ཨ་མི་ཐཱ་ཨིའི་བུ་ཡོ་ནཱ་ཡིན་པར་བརྗོད། འོན་ཀྱང་གཞུང་འདིའི་ནང་དུ་དོན་དེ་གསལ་པོར་བཀོད་མེད། གཞུང་འདི་ཉིད་ཡི་གེར་འགོད་མཁན་ཡོ་ནཱ་ཡིན་པའི་དབང་དུ་བཏང་ན། དེའི་ལོ་ཚིགས་སྤྱི་ལོ་སྔོན་གྱི་དུས་རབས་བརྒྱད་པའི་སྟོད་ཙམ་ལ་ངོས་འཛིན་བྱས་ཡོད།"
      ]
    },
    {
      "heading": "བརྗོད་སྙིང་དང་གསུང་འཕྲིན།",
      "paragraphs": [
        "གཞུང་འདི་ཉིད་ཀྱི་ལེའུ་བཞི་པོ་སྤྱིའི་བརྗོད་བྱ་ནི་འགྱོད་བཤགས་བྱས་པ་བརྒྱུད་ནས་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་དཀོན་མཆོག་གིས་ཐུགས་རྗེ་གནང་བར་མ་ཟད། གཞུང་འདིའི་ནང་དུ་དཀོན་མཆོག་གིས་ཡེས་ར་ཨེལ་ལ་བཅངས་པའི་ཁོང་གི་དགོངས་གཞི་རྒྱ་ཆེན་པོ་ཡང་བསྟན་ཡོད་དེ། ཡེས་རཱ་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་གིས་འཇིག་རྟེན་ཀུན་ལ་བཅངས་པའི་ཐུགས་ཁུར་དངོས་སླར་ཡང་རྟོགས་པ་དང་། ཁོ་རྣམས་ཀྱིས་དཀོན་མཆོག་གིས་བཅངས་པའི་ཐུགས་ཁུར་དེ་ནི་རང་གིས་བསྒྲུབ་དགོས་པའི་འགན་འཁུར་ཡིན་པ་ཡང་ལེགས་པར་རྟོགས་པ་དེའོ། །"
      ]
    },
    {
      "heading": "འཆར་ཟིན།",
      "paragraphs": [
        "1. ཡོ་ནཱ་རང་གི་ལས་དོན་ལ་བྱོལ་བའི་སྐོར། ༼1:1-2:10༽",
        "ཀ ཡོ་ནཱ་ལ་སྤྲད་པའི་འགན་ཁུར་དང་ཁོ་དེ་ལ་གཡོལ་ནས་བྲོས་པའི་སྐོར། ༼1:1-3༽",
        "ཁ། ཉེན་ཁར་ཕྲད་པའི་གྲུ་པ་རྣམས་ཀྱིས་རང་རང་གི་ལྷ་ལ་ཞུ་བ་བྱས་པ། ༼1:4-6༽",
        "ག ཡོ་ནཱས་བཀའ་མ་བརྩིས་པ་དེ་དཀོན་མཆོག་གིས་གསལ་པོར་བསྟན་པ། ༼1:7-10༽",
        "ང་། དཀོན་མཆོག་གིས་ཡོ་ནཱ་ལ་ཉེས་ཆད་བཅད་པར་མ་ཟད། ཁོ་ལ་ཐར་པ་ཡང་གནང་བ་དང་། ཡོ་ནཱས་གསོལ་བ་བཏབ་ནས་དགོངས་དག་ཞུས་པ། ༼1:11-2:10༽",
        "2. ཡོ་ནཱས་འདོད་བློ་མེད་བཞིན་དུ་རང་གི་ལས་དོན་བསྒྲུབས་པ། ༼3:1-4:11༽",
        "ཀ ཡོ་ནཱ་ལ་སླར་ཡང་འགན་ཁུར་སྤྲད་པ་དང་ཁོས་བཀའ་བརྩིས་པའི་སྐོར། ༼3:1-4༽",
        "ཁ། ཉེན་ཁར་ཕྲད་པའི་ནིན་ཝེ་པ་རྣམས་འགྱོད་པ་སྐྱེས་ནས་དཀོན་མཆོག་ལ་ཞུ་བ་བྱས་པ། ༼3:5-9༽",
        "ག དཀོན་མཆོག་གིས་ནིན་ཝེ་པ་རྣམས་ཀྱི་འགྱོད་བཤགས་ཞལ་བཞེས་གནང་བ། ༼3:10-4:4༽",
        "ང་། དཀོན་མཆོག་གིས་ཡོ་ནཱར་སྲུང་སྐྱོབ་གནང་བ་དང་། ཁོ་ལ་བཀའ་བཀྱོན་མཛད་པ། ༼4:5-11༽"
      ]
    }
  ]
}
